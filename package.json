{
  "name": "nudge",
  "version": "0.1.0",
  "description": "A customizable cartoon animal desktop companion for Windows that roams the screen and reacts to notifications.",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/build-watcher.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "watcher:build": "dotnet build native/NudgeWatcher/NudgeWatcher.csproj -c Debug",
    "watcher:build:release": "dotnet build native/NudgeWatcher/NudgeWatcher.csproj -c Release",
    "watcher:publish": "node scripts/publish-watcher.mjs",
    "dist:win": "npm run build && npm run watcher:publish && npx --yes --package=electron-builder@26.0.12 electron-builder --win nsis --x64 --publish never",
    "pack:win": "npm run build && npm run watcher:publish && npx --yes --package=electron-builder@26.0.12 electron-builder --win --x64 --dir --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xstate/react": "^5.0.0",
    "electron-store": "^8.2.0",
    "xstate": "^5.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript-eslint": "^8.8.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
