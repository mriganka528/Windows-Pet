{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react", "../node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*", "../node_modules/@types/react/*"]
    },
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src"]
}
