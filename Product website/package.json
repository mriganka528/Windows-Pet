{
  "name": "nudge-product-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-download.mjs && vite --host 127.0.0.1 --port 4176",
    "build": "node scripts/prepare-download.mjs && tsc --noEmit && vite build",
    "build:vercel": "node scripts/prepare-download.mjs --cloud && tsc --noEmit && vite build",
    "test:build": "node --test scripts/prepare-download.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "capture": "node scripts/capture-media.mjs",
    "capture:website": "node scripts/capture-website.mjs",
    "check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "nudge": "file:..",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.21.5",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
